        "lineageTag": "1a52b64c-e6de-4b9a-b07c-91e15dd3cfe5",
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "",
                "ADDCOLUMNS(",
                "   CALENDARAUTO(),",
                "    \"Year\", YEAR([Date]),",
                "    \"QuaterNum\", QUARTER([Date]),",
                "    \"Quater\", \"Q\" & QUARTER([Date]),",
                "    \"Month Num\", MONTH([Date]),",
                "    \"Month\", FORMAT([Date],\"mmm\"),",
                "    \"Month-Year\", YEAR([Date]) & \"-\" & FORMAT([Date],\"mmm\"),",
                "    \"MonthYearNum\", YEAR([Date]) &  FORMAT(MONTH([Date]),\"00\"),",
                "    \"WeekNum\", WEEKNUM([Date]),",
                "    \"Weekday\", WEEKDAY([Date]),",
                "    \"Week\", \"W\" & WEEKNUM([Date]),",
                "    \"Weekday Name\", FORMAT(WEEKDAY([Date]),\"ddd\"),",
                "    \"Day\", DAY([Date]),",
                "    \"Year Qn\",  YEAR([Date]) & \"Q\" & QUARTER([Date]),",
                "    \"Year Select\" , ",
                "    SWITCH ( TRUE()",
                "        , YEAR([Date]) = YEAR( TODAY() ) , \"  Current\"",
                "        , YEAR([Date]) = YEAR( TODAY() )-1 , \" Last\"",
                "        , YEAR([Date]) & \"\"",
                "    )",
                "",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
