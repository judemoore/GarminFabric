              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "dataType": "double",
            "expression": "DIVIDE( [distance] , 1000 )",
            "isDataTypeInferred": true,
            "lineageTag": "5045e9c1-55e3-4908-a277-eb380bf526bb",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "duration mins",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "dataType": "double",
            "expression": "IF ( [activityType.parentTypeId]=29 , DIVIDE( [duration] , 60 ,0 ) , DIVIDE(  [movingDuration] ,60 ,0) )",
            "isDataTypeInferred": true,
            "lineageTag": "2c93827a-5651-4e5a-bb33-db34cddf990e",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Date",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "changedProperties": [
              {
                "property": "DataType"
              }
            ],
            "dataType": "dateTime",
            "expression": [
              "",
              "    DATE(   ",
              "        YEAR(vwGarminActivity[startTimeLocal])",
              "        , MONTH(vwGarminActivity[startTimeLocal])",
              "        , DAY(vwGarminActivity[startTimeLocal])",
              "    )"
            ],
            "formatString": "Long Date",
            "isDataTypeInferred": true,
            "lineageTag": "abdca577-1fcc-452b-bf35-82879e23d27a",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Activity Type",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH ( TRUE()",
              "    , CONTAINSSTRING (\"running\",LOWER([activityType.typeKey]) ) ,\"Running\" ",
              "    , CONTAINSSTRING (\"lap_swimming\",LOWER([activityType.typeKey]) ), \"Swimming\" ",
              "    , CONTAINSSTRING (\"walking\",LOWER([activityType.typeKey]) ), \"Walking\" ",
              "    , CONTAINSSTRING (\"hiit\",LOWER([activityType.typeKey]) ), \"HIIT\" ",
              "    , UPPER(LEFT([activityType.typeKey],1)) & MID([activityType.typeKey], 2, LEN([activityType.typeKey]) ) ",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "29f76cd8-742e-40f3-98d1-59936d98da7a",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "6b7ac371-0bee-4eaf-829d-b25926d4e8d4",
        "partitions": [
          {
            "name": "vwGarminActivity",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Synapse.Contents(null),",
                "    personalprojectsrgsynapse = Source{[Name=\"personalprojectsrgsynapse\"]}[Data],",
                "    GarminFiles = personalprojectsrgsynapse{[Name=\"GarminFiles\"]}[Data],",
                "    dbo_vwGarminActivity = GarminFiles{[Schema=\"dbo\",Item=\"vwGarminActivity\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(dbo_vwGarminActivity,{{\"minActivityLapDuration\", type number}, {\"distance\", type number}, {\"duration\", type number}, {\"elapsedDuration\", type number}, {\"movingDuration\", type number}, {\"averageSpeed\", type number}, {\"endLongitude\", type number}, {\"endLatitude\", type number}, {\"maxVerticalSpeed\", type number}, {\"avgStrideLength\", type number}, {\"minElevation\", type number}, {\"maxElevation\", type number}, {\"averageRunningCadenceInStepsPerMinute\", type number}, {\"startLongitude\", type number}, {\"startLatitude\", type number}, {\"maxSpeed\", type number}, {\"startTimeLocal\", type datetime}, {\"hasPolyline\", Int64.Type}, {\"calories\", Int64.Type}, {\"bmrCalories\", Int64.Type}, {\"averageHR\", Int64.Type}, {\"maxHR\", Int64.Type}, {\"steps\", Int64.Type}, {\"timeZoneId\", Int64.Type}, {\"deviceId\", Int64.Type}, {\"lapCount\", Int64.Type}, {\"waterEstimated\", Int64.Type}, {\"totalSets\", Int64.Type}, {\"activeSets\", Int64.Type}, {\"totalReps\", Int64.Type}, {\"hasSplits\", Int64.Type}, {\"moderateIntensityMinutes\", Int64.Type}, {\"vigorousIntensityMinutes\", Int64.Type}, {\"pr\", Int64.Type}, {\"manualActivity\", Int64.Type}, {\"activityType.typeId\", Int64.Type}, {\"activityType.parentTypeId\", Int64.Type}, {\"activityType.trimmable\", Int64.Type}, {\"eventType.typeId\", Int64.Type}, {\"eventType.sortOrder\", Int64.Type}, {\"privacy.typeId\", Int64.Type}, {\"elevationGain\", Int64.Type}, {\"elevationLoss\", Int64.Type}, {\"maxRunningCadenceInStepsPerMinute\", Int64.Type}, {\"vO2MaxValue\", Int64.Type}}),",
                "    #\"Removed Other Columns\" = Table.SelectColumns(#\"Changed Type\",{\"activityId\", \"activityName\", \"startTimeLocal\", \"distance\", \"duration\", \"elapsedDuration\", \"movingDuration\", \"averageSpeed\", \"hasPolyline\", \"ownerProfileImageUrlMedium\", \"calories\", \"bmrCalories\", \"averageHR\", \"maxHR\", \"steps\", \"timeZoneId\", \"lapCount\", \"waterEstimated\", \"totalSets\", \"activeSets\", \"totalReps\", \"moderateIntensityMinutes\", \"vigorousIntensityMinutes\", \"differenceBodyBattery\", \"pr\", \"manualActivity\", \"activityType.typeId\", \"activityType.typeKey\", \"activityType.parentTypeId\", \"activityType.trimmable\", \"eventType.typeId\", \"eventType.typeKey\", \"eventType.sortOrder\", \"elevationGain\", \"elevationLoss\", \"maxSpeed\", \"startLatitude\", \"startLongitude\", \"averageRunningCadenceInStepsPerMinute\", \"maxRunningCadenceInStepsPerMinute\", \"avgStrideLength\", \"minElevation\", \"maxElevation\", \"maxDoubleCadence\", \"maxVerticalSpeed\", \"locationName\", \"endLatitude\", \"endLongitude\", \"vO2MaxValue\"})",
                "in",
                "    #\"Removed Other Columns\""
              ],
              "type": "m"
            }
          }
        ]
      },
