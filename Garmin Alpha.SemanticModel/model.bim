              "DIVIDE(",
              "    COUNTROWS(FILTER('SupplyChainDataset', 'SupplyChainDataset'[Delivery Status] = \"Shipping on time\" && 'SupplyChainDataset'[Late_delivery_risk] = 0)),",
              "    COUNT('SupplyChainDataset'[Order Id]),",
              "    0",
              ") ",
